# Single source of truth for everything this build pins. Sourced by the Makefile;
# override any of it on the command line (e.g. `make kernel TALOS_VERSION=v1.14.0`).

# --- Talos --------------------------------------------------------------------------
# The version the nodes run - the kernel is built against its exact pkgs pin, and this
# value also flows into the amneziawg-pkg build (both must move together).
TALOS_VERSION=v1.13.9

# --- upstream siderolabs pkgs ---------------------------------------------------------
# Source of the kernel config, signing certs, patch set and pinned kernel version. Not a
# free choice - derive it from the Talos version, see README "Pinning". `make check-pins`
# asserts it.
#
# Verbatim the string Talos publishes in pkg/machinery/gendata/data/pkgs, which is upstream's
# own notation for this pin (siderolabs/talos' Makefile carries it as PKGS and consumes
# ghcr.io/siderolabs/<pkg>:$(PKGS); siderolabs/extensions templates read it as
# {{ .BUILD_ARG_PKGS }}). It is a `git describe` string, so it also names the OCI tag those
# images are published under - and the Makefile slices the abbreviated object id off its tail
# to check out the source this repo needs. Abbreviated, so it resolves locally but is never
# fetchable on its own; see the Makefile's checkout-pkgs.
#
# Not the bare `vX.Y.Z` tag, which is a different tree: upstream tags pkgs once per minor
# Talos release and keeps committing to the branch afterwards, so the tag is the state as of
# the alpha. For 1.14.0 the tag carries Linux 6.18.44 while Talos itself ships 6.18.48 - a
# module built against the tag would claim the wrong vermagic and refuse to load.
PKGS=v1.13.0-60-gf541ca4

# --- the thing we actually package ---------------------------------------------
# amnezia-vpn/amneziawg-linux-kernel-module. Regenerate both hashes with `make hashes`
# after changing the ref.
#
# A release tag, and the first one that carries the use-after-free fix this build needs:
# wg_packet_create_data_done() used to read PACKET_CB(skb)->is_keepalive *after* handing
# the skb to wg_socket_send_skb_to_peer(), which reuses skb->cb - a UAF read behind the
# recurring "KFENCE: use-after-free read in wg_packet_tx_worker" reports (freed
# skbuff_head_cache).
#
# 3.1 adds two device attributes, WGDEVICE_A_RANDOM_TRAILERS and
# WGDEVICE_A_DISABLE_COOKIES, at the end of the enum. WG_GENL_VERSION stays 3 and no
# existing attribute moves or changes type, so a daemon built against 3.0 keeps working:
# it sets neither, and its decoder puts what it does not recognise aside.
AWG_REF=v3.1.20260812
AWG_SHA256=a85817876676d5933385712657bd5525a0a2939baaf057f68e3629c7b4553c82
AWG_SHA512=2d53bcb822c3fe51e69c3167b1ffdb86b820b9f70f364d94e0c1ca8d131f91bc6b89db1a0fcfdefa5cc73580538d4b2c25586d66b7d5b7f86a3569d471a74a63

# --- where the artifacts go -------------------------------------------------------
# One repo per artifact under this namespace (kernel, amneziawg-pkg) - see README
# "Publishing" for why. Consumers (talos-awg-extension, talos-installer) read these same
# TALOS_VERSION/AWG_REF values to reconstruct the exact tag this repo publishes under -
# keep them in sync when bumping either pin here.
DOCKER_NS=ghcr.io/slipmesh
