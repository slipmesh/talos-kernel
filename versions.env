# Single source of truth for everything this build pins. Sourced by the Makefile;
# override any of it on the command line (e.g. `make kernel TALOS_VERSION=v1.14.0`).

# --- Talos --------------------------------------------------------------------------
# The release the nodes run. The kernel is built from its exact pkgs pin, and a release of this
# repository is named after it: vX.Y.Z+sm.N.
TALOS_VERSION=v1.14.5

# --- upstream siderolabs pkgs ---------------------------------------------------------
# Source of the kernel config, signing certs, patch set and pinned kernel version. Not a
# free choice - derive it from the Talos version, see README "Pinning". `make check-pins`
# asserts it.
#
# Verbatim the `git describe` string Talos publishes in pkg/machinery/gendata/data/pkgs -
# upstream's own notation, which doubles as the OCI tag its pkgs images carry.
#
# Not the bare `vX.Y.Z` tag, which is a different tree: upstream tags pkgs once per minor
# Talos release and keeps committing afterwards. For 1.14.0 the tag carries Linux 6.18.44
# while Talos ships 6.18.48, so a module built against it would refuse to load.
PKGS=v1.14.0-48-gf4bda77

# --- the thing we actually package ---------------------------------------------
# amnezia-vpn/amneziawg-linux-kernel-module. Regenerate both hashes with `make hashes`
# after changing the ref.
#
# A release tag. Over the previous pin it fixes the I1-I5 junk-spec parser, which ext-awg feeds
# from machine config: a negative tag size was accepted, and the sizes of all tags were summed
# without a bound. The plain v3.1.20261113 tag carries only an Ubuntu compat change; the fixes
# are in -02.
#
# 3.1 adds two device attributes, WGDEVICE_A_RANDOM_TRAILERS and
# WGDEVICE_A_DISABLE_COOKIES, at the end of the enum. WG_GENL_VERSION stays 3 and no
# existing attribute moves or changes type, so a daemon built against 3.0 keeps working:
# it sets neither, and its decoder puts what it does not recognise aside.
AWG_REF=v3.1.20261113-02
AWG_SHA256=92cadd8fc7e885a2d34b439e3844f2394ebfc9908a42e11dd993163f3e18d405
AWG_SHA512=1bdffa8897407723832f96862251eb52f5135da981f5b6105d158fec41e8e4e89b27d68a5bb8f057e448b5d6beea76862eb3d673c5422dda43aae377d400d1d2

# --- where the artifacts go -------------------------------------------------------
# kernel and amneziawg-pkg are published under this prefix. talos-installer names a release of
# this repository and takes both images from its tag.
REGISTRY=ghcr.io/slipmesh
